# BG3Tools - PUBLIC repo. Shared build/install + generic game-driving scripts.

# builds go to each mod repo's dist/; older versions of the tools wrote them here
dist/
# archive of every local build (tools/builds.py): last 30 dev builds + every release build
builds/
# profile backup + code_snapshots zip baselines (git replaces the zips from here on)
backups/
# screenshots and snapshots of tools/testing (screenshot.ps1, crop.png, loadfail_*.png)
screenshots/
*.exe
# python / editor clutter
__pycache__/
*.pyc
*.mp4
Thumbs.db
desktop.ini
*.pak
*.dds
*.DDS
*.glb
*.gr2

# BG3Tools - PUBLIC repo. Shared build/install + generic game-driving scripts.


# Script Extender logs (12.5 GB)
se-logs/
# built paks (generated by tools/build_pak.py)
dist/
# archive of every local build (tools/builds.py): last 30 dev builds + every release build
builds/
# profile backup + code_snapshots zip baselines (git replaces the zips from here on)
backups/
# scratch screenshots of the driving scripts (crop/mini/list_now/who.png); the tpl_*.png templates stay tracked
tools/bg3drive/*.png
!tools/bg3drive/tpl_*.png
# loopcap.exe is built from loopcap.cs (tracked)
*.exe
# python / editor clutter
__pycache__/
*.pyc
*.mp4
Thumbs.db
desktop.ini
*.pak
*.dds
*.DDS
*.glb
*.gr2

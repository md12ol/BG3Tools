#!/bin/sh
# rec.sh start NAME | stop : full-resolution 60 fps screen recording (ffmpeg ddagrab + NVENC) to Desktop\NAME.mp4.
# Fragmented MP4, so stopping (taskkill of ffmpeg only, never the game) leaves a playable file.
# Source: gfxcapture (Windows Graphics Capture) of the BG3 window, 2560x1600 @ 60. ddagrab (desktop duplication) fails
# with DXGI ACCESS_LOST (887a0026) while BG3 runs. Frames live on the display adapter (iGPU on this laptop), so they are
# downloaded to system memory (hwdownload) before NVENC; feeding them straight to NVENC fails ("Could not open encoder").
# A watchdog restarts a dead recorder into NAME_partN.mp4 until "rec.sh stop".
F="$LOCALAPPDATA/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.0.2-full_build/bin/ffmpeg.exe"
FLAG="$TEMP/bg3rec.on"
case "$1" in
  start)
    echo "$2" > "$FLAG"
    (
      n=1
      while [ -f "$FLAG" ]; do
        out="$USERPROFILE/Desktop/$2.mp4"; [ $n -gt 1 ] && out="$USERPROFILE/Desktop/$2_part$n.mp4"
        "$F" -hide_banner -loglevel error -y -f lavfi -i gfxcapture=window_exe=bg3_dx11.exe:max_framerate=60 -vf hwdownload,format=bgra \
          -c:v h264_nvenc -preset p4 -cq 23 -r 60 -movflags +frag_keyframe+empty_moov "$out" < /dev/null >> "$TEMP/bg3rec.log" 2>&1
        n=$((n+1)); sleep 1
      done
    ) > /dev/null 2>&1 &
    sleep 2; tasklist | grep -i -q ffmpeg && echo "recording -> Desktop/$2.mp4" || echo "recorder failed (see $TEMP/bg3rec.log)";;
  stop)
    rm -f "$FLAG"; taskkill //IM ffmpeg.exe //F > /dev/null 2>&1; sleep 1; echo "recording stopped";;
esac

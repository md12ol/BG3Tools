#!/bin/sh
# rec.sh start NAME | stop : full-resolution 60 fps screen recording WITH game audio to Desktop\NAME.mp4.
# Video: ffmpeg gfxcapture (Windows Graphics Capture) of the BG3 window, 2560x1600 @ 60, MediaFoundation hardware
#   H.264 (h264_mf; NVENC only managed ~40 fps while the game used the GPU, so the recording ran slow and the tail was
#   lost when it was stopped - a34), into NAME_v.mp4
#   (fragmented MP4, so a killed recorder leaves a playable file). ddagrab fails with DXGI ACCESS_LOST while BG3 runs;
#   frames live on the iGPU, so hwdownload is needed before NVENC.
# Audio: tools/bg3drive/loopcap.exe = WASAPI loopback of the default playback device (own helper, no install, no
#   Windows sound setting changed) -> NAME.raw. It starts when the video file appears (trigger file).
# stop: kills both recorders (never the game), then muxes video + audio (AAC) into NAME.mp4 and removes the temp files.
# A watchdog restarts a dead video recorder into NAME_partN.mp4 until "rec.sh stop".
HERE="$(cd "$(dirname "$0")" && pwd)"
F="$LOCALAPPDATA/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.0.2-full_build/bin/ffmpeg.exe"
FLAG="$TEMP/bg3rec.on"
DESK="C:/Users/micha/Desktop"
case "$1" in
  start)
    echo "$2" > "$FLAG"; rm -f "$TEMP/bg3rec.trig"
    "$HERE/loopcap.exe" "$DESK/$2.raw" "$TEMP/bg3rec.trig" >> "$TEMP/bg3rec.log" 2>&1 &
    (
      n=1
      while [ -f "$FLAG" ]; do
        out="$DESK/$2_v.mp4"; [ $n -gt 1 ] && out="$DESK/$2_part$n.mp4"
        "$F" -hide_banner -loglevel error -y -f lavfi -i gfxcapture=window_exe=bg3_dx11.exe:max_framerate=60 -vf hwdownload,format=bgra,format=nv12 \
          -c:v h264_mf -hw_encoding 1 -rate_control quality -quality 70 -b:v 16M -r 60 -movflags +frag_keyframe+empty_moov "$out" < /dev/null >> "$TEMP/bg3rec.log" 2>&1
        n=$((n+1)); sleep 1
      done
    ) > /dev/null 2>&1 &
    # start the audio when the first video frame has been written (file bigger than the bare header)
    for i in $(seq 1 100); do
      [ -f "$DESK/$2_v.mp4" ] && [ "$(stat -c %s "$DESK/$2_v.mp4" 2>/dev/null || echo 0)" -gt 4000 ] && break; sleep 0.05
    done
    : > "$TEMP/bg3rec.trig"
    sleep 1; tasklist | grep -i -q ffmpeg && tasklist | grep -i -q loopcap && echo "recording (video+audio) -> Desktop/$2.mp4" || echo "recorder failed (see $TEMP/bg3rec.log)";;
  stop)
    N=$(cat "$FLAG" 2>/dev/null); rm -f "$FLAG"
    taskkill //IM loopcap.exe //F > /dev/null 2>&1; taskkill //IM ffmpeg.exe //F > /dev/null 2>&1; sleep 1
    if [ -n "$N" ] && [ -f "$DESK/${N}_v.mp4" ]; then
      if [ -s "$DESK/$N.raw" ]; then
        vd=$("${F%ffmpeg.exe}ffprobe.exe" -v error -show_entries format=duration -of csv=p=0 "$DESK/${N}_v.mp4" 2>/dev/null)
        # both recorders are killed together, so their ENDS line up: the audio starts (vd - ad) s after the video does
        AUDIO_DELAY=$(awk -v v="$vd" -v b="$(stat -c %s "$DESK/$N.raw")" 'BEGIN{d=v-b/192000; if(d<0)d=0; if(d>6)d=0; printf "%.3f", d}')
        echo "rec $N: video ${vd}s, audio $(( $(stat -c %s "$DESK/$N.raw") / 192000 ))s, audio delayed ${AUDIO_DELAY}s" | tee -a "$TEMP/bg3rec.log"
        "$F" -hide_banner -loglevel error -y -i "$DESK/${N}_v.mp4" -itsoffset "$AUDIO_DELAY" -f s16le -ar 48000 -ac 2 -i "$DESK/$N.raw" \
          -map 0:v -map 1:a -c:v copy -c:a aac -b:a 160k -shortest -movflags +faststart "$DESK/$N.mp4" >> "$TEMP/bg3rec.log" 2>&1 \
          && "${F%ffmpeg.exe}ffprobe.exe" -v error -show_entries stream=codec_type -of csv=p=0 "$DESK/$N.mp4" | grep -q audio           && rm -f "$DESK/${N}_v.mp4" "$DESK/$N.raw" || echo "MUX FAILED - kept ${N}_v.mp4 and $N.raw"
      else
        mv -f "$DESK/${N}_v.mp4" "$DESK/$N.mp4"; echo "no audio captured"
      fi
    fi
    echo "recording stopped";;
esac
